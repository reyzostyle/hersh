{
  "manifest_version": 3,
  "name": "Chumoku",
  "short_name": "Chumoku",
  "version": "0.2.5",
  "description": "The Shorts workflow, automated. Analyze any Short or steal its format as an outline for your channel, beside the video.",
  "homepage_url": "https://chumoku.co",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chumoku",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "analyze": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Analyze the Short you're watching"
    },
    "steal": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Steal the format of the Short you're watching"
    }
  },
  "host_permissions": [
    "https://chumoku.co/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "minimum_chrome_version": "116"
}
