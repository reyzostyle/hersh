    "Ask anything about your channel, an idea or a script. Each answer is 1 credit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta lo que quieras sobre tu canal, una idea o un guion. Cada respuesta cuesta 1 crédito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa sobre seu canal, uma ideia ou um roteiro. Cada resposta custa 1 crédito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose n'importe quelle question sur ta chaîne, une idée ou un script. Chaque réponse coûte 1 crédit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag alles zu deinem Kanal, einer Idee oder einem Skript. Jede Antwort kostet 1 Credit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネル、アイデア、台本について何でも聞いてください。回答ごとに1クレジットです。"
          }
        }
      }
    },
