    },
    "There is no wrong answer here. Whatever you leave out is read off your uploads.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay respuestas incorrectas. Lo que no pongas lo sacamos de tus videos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existe resposta errada. O que você deixar de fora a gente tira dos seus vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de mauvaise réponse. Ce que tu laisses de côté, on le lit dans tes vidéos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es keine falsche Antwort. Was du weglässt, lesen wir aus deinen Uploads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解も不正解もありません。書かなかったことは、あなたの動画から読み取ります。"
          }
        }
      }
    },
