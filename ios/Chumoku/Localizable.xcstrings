    "Your edits stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas edições ficam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes modifications restent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen bleiben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの編集は残ります。"
          }
        }
      }
    },
    "Your ideas, chats, channels, credits and brain are deleted for good, here and on chumoku.co. A paid plan is cancelled now. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ideas, chats, canales, créditos y cerebro se borran para siempre, aquí y en chumoku.co. Un plan de pago se cancela ahora. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas ideias, chats, canais, créditos e cérebro são apagados para sempre, aqui e no chumoku.co. Um plano pago é cancelado agora. Isso não pode ser desfeito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes idées, chats, chaînes, crédits et ton cerveau sont supprimés définitivement, ici et sur chumoku.co. Une formule payante est annulée maintenant. C'est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ideen, Chats, Kanäle, Credits und dein Gehirn werden endgültig gelöscht, hier und auf chumoku.co. Ein bezahlter Tarif wird sofort gekündigt. Das lässt sich nicht rückgängig machen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデア、チャット、チャンネル、クレジット、ブレインは、ここでもchumoku.coでも完全に削除されます。有料プランは今すぐ解約されます。元に戻せません。"
          }
        }
      }
    },
