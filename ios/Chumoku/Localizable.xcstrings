    "Written from what you wrote. Connect your channel and this gets read off your real uploads instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito a partir de lo que pusiste. Conecta tu canal y se leerá de tus videos reales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito a partir do que você escreveu. Conecte seu canal e isso passa a ser lido dos seus vídeos reais."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit à partir de ce que tu as dit. Connecte ta chaîne et ce sera lu dans tes vraies vidéos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
