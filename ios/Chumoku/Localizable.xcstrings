    "Chumoku reads your Shorts and picks every idea for your channel. Read-only, nothing is ever posted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumoku lee tus Shorts y elige cada idea para tu canal. Solo lectura, nunca publica nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Chumoku lê seus Shorts e escolhe cada ideia para o seu canal. Só leitura, nada é publicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumoku lit tes Shorts et choisit chaque idée pour ta chaîne. Lecture seule, rien n'est jamais publié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumoku liest deine Shorts und wählt jede Idee für deinen Kanal. Nur lesen, es wird nie etwas gepostet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChumokuがあなたのShortsを読み、チャンネルに合うアイデアを選びます。読み取りのみで、投稿は一切しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumoku читает твои Shorts и подбирает каждую идею под твой канал. Только чтение, ничего не публикуется."
          }
        }
      }
    },
